# ==========================================
# SkinMinder — Environment Variables
# ==========================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# ------------------------------------------
# Supabase (Required)
# ------------------------------------------
# Get these from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------
# Anthropic AI (Required for production)
# ------------------------------------------
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_MODEL=claude-3-5-sonnet-20240620
AI_MAX_TOKENS=1024

# ------------------------------------------
# Ollama (Optional — alternative to Anthropic)
# ------------------------------------------
# If set, overrides Anthropic for local development
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma:2b

# ------------------------------------------
# Cloudinary Image Hosting (Required)
# ------------------------------------------
# Get from https://cloudinary.com/console
# CLOUDINARY_URL is the only var needed at runtime.
# The individual vars are for reference only.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ------------------------------------------
# App Configuration (Required)
# ------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://skinminder.ai

# ------------------------------------------
# Analytics (Optional)
# ------------------------------------------
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
# NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key

# ------------------------------------------
# Error Monitoring — Sentry (Optional)
# ------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# ------------------------------------------
# Rate Limiting (Optional overrides)
# ------------------------------------------
# RATE_LIMIT_SCAN_WINDOW_MS=60000
# RATE_LIMIT_SCAN_MAX=5
# RATE_LIMIT_API_WINDOW_MS=60000
# RATE_LIMIT_API_MAX=60

# ------------------------------------------
# Mock Mode (Development only)
# ------------------------------------------
MOCK_MODE=false
MOCK_DELAY_MS=500

# ------------------------------------------
# Web Push Notifications (Optional)
# ------------------------------------------
# Generate keys with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ------------------------------------------
# Image Quality Thresholds (Optional)
# ------------------------------------------
# QUALITY_MIN_LIGHTING=0.35
# QUALITY_MAX_SHADOW_GRADIENT=0.4
# QUALITY_MIN_SHARPNESS=0.15
# QUALITY_MAX_TILT=15
# QUALITY_MIN_COVERAGE=0.30
# QUALITY_MAX_OCCLUSION=0.35
# QUALITY_MAX_BACKGROUND_ENTROPY=0.6
# QUALITY_DUPLICATE_WINDOW_MS=60000
