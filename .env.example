# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic AI (Required for production)
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_MODEL=claude-3-5-sonnet-20240620
AI_MAX_TOKENS=1024

# Cloudinary Image Hosting (Required)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://skinminder.ai
NEXT_PUBLIC_APP_NAME=SkinMinder

# Analytics (Optional)
NEXT_PUBLIC_ANALYTICS_PROVIDER=none  # Options: postHog, google, none
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key

# Error Monitoring - Sentry (Optional)
SENTRY_ORG=your-org
SENTRY_PROJECT=skinminder
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Rate Limiting (Optional overrides)
RATE_LIMIT_SCAN_WINDOW_MS=60000
RATE_LIMIT_SCAN_MAX=5
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=60

# Mock Mode (Development)
MOCK_MODE=false
MOCK_DELAY_MS=500

# Web Push Notifications (Optional - generate with web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
