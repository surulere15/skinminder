{
  "expo": {
    "name": "SkinMinder",
    "slug": "skinminder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "skinminder",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skinminder.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SkinMinder uses your camera to analyze your skin and provide personalized recommendations.",
        "NSPhotoLibraryUsageDescription": "SkinMinder accesses your photos to let you upload existing skin images for analysis.",
        "NSFaceIDUsageDescription": "SkinMinder uses Face ID for secure authentication."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.skinminder.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SkinMinder to access your camera for skin analysis."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SkinMinder to access your photos for skin analysis."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
