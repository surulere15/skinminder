# ==========================================
# SkinMinder Mobile — Environment Variables
# ==========================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# ------------------------------------------
# Supabase (Required)
# ------------------------------------------
# Must match the web app's Supabase project.
# Use the ANON key (NOT the service role key) — this runs on the device.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ------------------------------------------
# API URL (Required)
# ------------------------------------------
# Points to the web app's API (Next.js server).
# The mobile app sends scan uploads and AI analysis here.
EXPO_PUBLIC_API_URL=https://api.skinminder.ai
