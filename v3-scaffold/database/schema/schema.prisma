datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  profile   Profile?
  scans     Scan[]
  createdAt DateTime @default(now())
}

model Profile {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  archetype String?
  goals     Json?
}

model Scan {
  id               String   @id @default(uuid())
  user             User     @relation(fields: [userId], references: [id])
  userId           String
  vendorId         String?
  imageUrl         String
  status           String   @default("processing")
  metrics          Metric?
  recommendations  Recommendation[]
  createdAt        DateTime @default(now())
}

model Metric {
  scanId       String @id
  scan         Scan   @relation(fields: [scanId], references: [id])
  hydration    Float
  pigmentation Float
  pih          Float
  acne         Float
  oiliness     Float
  sensitivity  Float
  confidence   Json
}

model Recommendation {
  id        String @id @default(uuid())
  scan      Scan   @relation(fields: [scanId], references: [id])
  scanId    String
  productId String
  content   String
}
