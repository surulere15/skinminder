{
  "name": "skinminder",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:mobile": "pnpm --filter skinminder-mobile start",
    "build": "next build",
    "build:mobile": "pnpm --filter skinminder-mobile exec expo export",
    "start": "next start",
    "start:mobile": "pnpm --filter skinminder-mobile start",
    "lint": "next lint",
    "lint:mobile": "pnpm --filter skinminder-mobile lint",
    "test": "vitest",
    "test:mobile": "pnpm --filter skinminder-mobile test",
    "db:seed": "tsx db/seed/run.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:mobile": "pnpm --filter skinminder-mobile exec tsc --noEmit",
    "clean": "rm -rf node_modules .next && pnpm --filter skinminder-mobile exec rm -rf node_modules .expo"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.62",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@sentry/nextjs": "^10.47.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.98.0",
    "anthropic-sdk": "npm:@anthropic-ai/sdk@^0.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.451.0",
    "next": "^14.2.0",
    "rate-limiter-flexible": "^10.0.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-dropzone": "^14.3.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.4.0",
    "shadcn": "^4.0.2",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
